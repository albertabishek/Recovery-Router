    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Detect if this is a raw Razorpay webhook (payment.failed / payment_link.paid)\nconst body = $json.body || $json;\nconst rzpEvent = body.event; // e.g. 'payment.failed', 'payment_link.paid'\nconst entity = body.payload?.payment?.entity;\n\nif (rzpEvent === 'payment.failed' && entity) {\n  // Raw Razorpay payment.failed webhook\n  return {\n    event_type: 'payment_failure',\n    payment_id: entity.id || '',\n    amount: (entity.amount || 0) / 100, // paise to rupees\n    currency: entity.currency || 'INR',\n    method: entity.method || '',\n    error_code: entity.error_code || '',\n    customer_email: entity.email || '',\n    customer_phone: entity.contact || '',\n    customer_name: entity.notes?.customer_name || entity.card?.name || '',\n    order_id: entity.order_id || '',\n    invoice_id: entity.invoice_id || '',\n    event_timestamp: new Date().toISOString(),\n    cart_value: 0,\n    items_in_cart: 0,\n    days_overdue: 0,\n    error_description: entity.error_description || '',\n    error_reason: entity.error_reason || '',\n    error_source: entity.error_source || '',\n    error_step: entity.error_step || '',\n    razorpay_raw: true\n  };\n}\n\n// Custom webhook format (existing behavior)\nreturn {\n  event_type: body.event_type || 'unknown',\n  payment_id: body.razorpay_payment_id || body.payment_id || '',\n  amount: body.amount || 0,\n  currency: body.currency || 'INR',\n  method: body.method || '',\n  error_code: body.error_code || '',\n  customer_email: body.customer_email || '',\n  customer_phone: body.customer_phone || '',\n  customer_name: body.customer_name || '',\n  order_id: body.order_id || body.invoice_id || '',\n  invoice_id: body.invoice_id || '',\n  event_timestamp: body.timestamp || new Date().toISOString(),\n  cart_value: body.cart_value || 0,\n  items_in_cart: body.items_in_cart || 0,\n  days_overdue: body.days_overdue || 0,\n  razorpay_raw: false\n};"
      },
      "id": "d0bf46b7-4c30-4dd1-97d1-a57402b7fcf8",
