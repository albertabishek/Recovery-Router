    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const body = $json.body || $json;\nconst event = body.event || '';\n\n// Handle payment_link.paid event\nif (event === 'payment_link.paid') {\n  const plEntity = body.payload?.payment_link?.entity || {};\n  const payEntity = body.payload?.payment?.entity || {};\n  return {\n    payment_id: payEntity.id || '',\n    amount: (payEntity.amount || plEntity.amount || 0) / 100,\n    order_id: payEntity.order_id || plEntity.reference_id || '',\n    method: payEntity.method || '',\n    captured_at: new Date().toISOString(),\n    event_source: 'payment_link.paid',\n    payment_link_id: plEntity.id || '',\n    reference_id: plEntity.reference_id || ''\n  };\n}\n\n// Handle payment.captured event (existing)\nconst entity = body.payload?.payment?.entity || {};\nreturn {\n  payment_id: entity.id || '',\n  amount: (entity.amount || 0) / 100,\n  order_id: entity.order_id || '',\n  method: entity.method || '',\n  captured_at: new Date().toISOString(),\n  event_source: event || 'payment.captured',\n  payment_link_id: '',\n  reference_id: ''\n};"
      },
      "id": "3bbb34de-aab0-45a1-95ea-23b01fd8ebb7",
