    {
      "parameters": {
        "jsCode": "const now = new Date();\nconst actionable = [];\nfor (const item of $input.all()) {\n  const e = item.json;\n  const windowEnds = e.recovery_window_ends ? new Date(e.recovery_window_ends) : new Date(now.getTime() + 259200000);\n  const attemptCount = e.attempt_count || 0;\n  const maxAttempts = e.max_attempts || 5;\n  if (e.opted_out) continue;\n  if (windowEnds <= now) continue;\n  if (attemptCount >= maxAttempts) continue;\n  // Skip unrecoverable declines (fraud/stolen card)\n  if (e.failure_category === 'unrecoverable_decline' || e.failure_category === 'fraud_detected') continue;\n  if (e.recovery_probability === 0) continue;\n  actionable.push({ json: e });\n}\nreturn actionable.length > 0 ? actionable : [{ json: { _empty: true } }];"
      },
      "id": "d104cef1-538e-49b3-9b1c-825399318bd9",
      "name": "Filter Actionable",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        848,
        304
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ 'Decide next recovery action:\\n\\nEvent ID: ' + $json.id + '\\nType: ' + ($json.event_type || 'unknown') + '\\nCategory: ' + ($json.failure_category || 'unknown') + '\\nAmount: Rs.' + ($json.amount || 0) + '\\nCustomer: ' + ($json.customer_name || 'Unknown') + '\\nPhone: ' + ($json.customer_phone || 'N/A') + '\\nEmail: ' + ($json.customer_email || 'N/A') + '\\nAttempts so far: ' + ($json.attempt_count ?? 0) + '/' + ($json.max_attempts ?? 5) + '\\nCurrent strategy: ' + ($json.current_strategy ?? 'initial') + '\\nEscalation level: ' + ($json.escalation_level ?? 0) + '\\nOriginal channel: ' + ($json.recommended_channel ?? 'none') + '\\nRecovery probability: ' + ($json.recovery_probability ?? 0) + '\\nPayment Link: ' + ($(\"Generate Esc Payment Link\").item.json.short_url ?? 'https://rzp.io/retry') }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are the Escalation Agent for Recovery Router, an autonomous AI revenue recovery system for Indian digital payments (Razorpay). You decide the NEXT recovery action for pending revenue leaks based on attempt history.\n\nESCALATION STRATEGY:\n- Attempt 0 (first contact): Use originally recommended channel with friendly reminder tone\n- Attempt 1: Switch channel. WhatsApp->Email, Email->WhatsApp, SMS->WhatsApp\n- Attempt 2: Use SMS with urgent tone (time-sensitive language)\n- Attempt 3: Send final notice via email (formal, mention escalation)\n- Attempt 4+: Set next_channel to give_up (max attempts reached)\n\nCHANNEL SELECTION:\n- High recovery_probability (>0.6): Aggressive - WhatsApp first, then SMS, then email final\n- Medium (0.3-0.6): Moderate - Email first, then WhatsApp, then SMS\n- Low (<0.3): Conservative - One attempt via cheapest channel, then give_up\n\nFor unrecoverable_decline (was fraud_detected) or recovery_probability 0: Always set next_channel to give_up.\n\nMESSAGE TONE ESCALATION:\n- Level 0: Friendly reminder. Hi {name}, your payment of Rs.{amount} needs attention.\n- Level 1: Firm follow-up. We noticed your payment is still pending.\n- Level 2: Urgent. Action required - your payment of Rs.{amount} needs immediate attention.\n- Level 3: Final notice. This is our final reminder regarding your pending payment.\n\nRULES:\n- message_text must be complete, ready to send, with customer name and amount\n- Keep SMS under 160 characters\n- For give_up: set message_text to empty string\n- ALWAYS use the exact Payment Link URL provided in the input (NOT a placeholder)\n- next_channel MUST be one of: whatsapp, email, sms, give_up\n\nReturn structured JSON matching the output parser schema."
        }
      },
