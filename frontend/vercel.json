{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api.albertabishek.com/api/:path*"
    },
    {
      "source": "/webhook/:path*",
      "destination": "https://api.albertabishek.com/webhook/:path*"
    }
  ]
}
