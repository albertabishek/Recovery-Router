# Supabase project URL and PUBLIC anon key (used for realtime subscriptions only)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Leave empty in dev (Vite proxies /api to localhost:8000).
# In production set to the deployed backend origin, e.g. https://recovery-router-api.up.railway.app
VITE_API_BASE=
